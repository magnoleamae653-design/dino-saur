Import javax.swing.*;
Import java.awt.*;
Import java.awt.event.*;
Import java.awt.geom.Path2D;
Import java.util.ArrayList;
Import java.util.Iterator;
Import java.util.List;
Import java.util.Random;

Public class DinoGame extends JPanel implements ActionListener, KeyListener {

    // ---- Screen / world constants ----
    Private static final int WIDTH = 800;
    Private static final int HEIGHT = 300;
    Private static final int GROUND_Y = 240;

    // ---- Dino constants ----
    Private static final int DINO_X = 60;
    Private static final int DINO_W = 44;
    Private static final int DINO_H = 44;
    Private static final double GRAVITY = 0.8;
    Private static final double JUMP_VELOCITY = -14.5; 

    // ---- Dash constants ----
    Private static final int DASH_FRAMES = 24;           
    Private static final double DASH_MULT = 2.2;         

    // ---- Spike strip constants ----
    Private static final int SPIKE_H = 18;
    Private static final int SPIKE_W = 14;

    Private static final double SPIKE_LENGTH_FRAMES = 40;

    // ---- Heart constants ----
    Private static final int HEART_PENALTY = 300;   
    Private static final int INVULN_FRAMES = 75;         
    Private static final int HEART_SIZE = 24;

    // ---- Meat constants ----
    Private static final int MEAT_POINTS = 100;         
    Private static final int MEAT_SCORE_REQUIRED = 500; 
    Private static final int MEAT_SIZE = 24;

    Private static final Color FG = new Color(83, 83, 83);
    Private static final Color BG = Color.WHITE;
    Private static final Color HEART_RED = new Color(220, 50, 70);

    // ---- Game state ----
    Private double dinoY = GROUND_Y – DINO_H;
    Private double velY = 0;
    Private boolean onGround = true;
    Private boolean started = false;
    Private boolean gameOver = false;

    Private int dashTimer = 0;       
    Private boolean dashKeyHeld = false;

    Private boolean hasHeart = true;
    Private int invuln = 0;          
    Private int penaltyTimer = 0;    
    Private int heartCountdown = 0;  
    Private int meatCountdown = 0;  
    Private int bonusTimer = 0;     

    Private double speed = 6;
    Private double score = 0;
    Private double progress = 0;   
    Private int highScore = 0;
    Private int frame = 0;
    Private double groundOffset = 0;
    Private double distanceSinceSpawn = 0;
    Private double nextGap = 400;

    Private final List<Obstacle> obstacles = new ArrayList<>();
    Private final List<Heart> hearts = new ArrayList<>();
    Private final List<Meat> meats = new ArrayList<>();
    Private final List<double[]> clouds = new ArrayList<>(); // {x, y}
    Private final Random rng = new Random();
    Private final Timer timer = new Timer(16, this); // ~60 FPS

    Private static class Obstacle {
        Double x;
        Final int y, w, h;
        Final boolean spikes;

        Obstacle(double x, int y, int w, int h, boolean spikes) {
            This.x = x;
            This.y = y;
            This.w = w;
            This.h = h;
            This.spikes = spikes;
        }

        Rectangle hitbox() {
            If (spikes) {
                // forgiving on the spike tips
                Return new Rectangle((int) x + 2, y + 6, w – 4, h – 6);
            }
            Return new Rectangle((int) x + 3, y + 3, w – 6, h – 6);
        }
    }

    Private static class Heart {
        Double x;
        Final int y;
        Final boolean air;

        Heart(double x, int y, boolean air) {
            This.x = x;
            This.y = y;
            This.air = air;
        }

        Rectangle box() {
            Return new Rectangle((int) x, y, HEART_SIZE, HEART_SIZE);
        }
    }

    Private static class Meat {
        Double x;
        Final int y;
        Final boolean air;

        Meat(double x, int y, boolean air) {
            This.x = x;
            This.y = y;
            This.air = air;
        }

        Rectangle box() {
            Return new Rectangle((int) x, y, MEAT_SIZE, MEAT_SIZE);
        }
    }

    Public DinoGame() {
        setPreferredSize(new Dimension(WIDTH, HEIGHT));
        setBackground(BG);
        setFocusable(true);
        addKeyListener(this);

        for (int I = 0; I < 4; i++) {
            clouds.add(new double[]{rng.nextInt(WIDTH), 30 + rng.nextInt(80)});
        }
        Timer.start();
    }

    // ------------------------------------------------------------------
    // Game logic
    // ------------------------------------------------------------------

    Private void reset() {
        Obstacles.clear();
        Hearts.clear();
        Meats.clear();
        dinoY = GROUND_Y – DINO_H;
        velY = 0;
        onGround = true;
        dashTimer = 0;
        hasHeart = true;
        invuln = 0;
        penaltyTimer = 0;
        heartCountdown = 0;
        meatCountdown = 60 + rng.nextInt(120);
        bonusTimer = 0;
        speed = 6;
        score = 0;
        progress = 0;
        distanceSinceSpawn = 0;
        nextGap = 400;
        gameOver = false;
        started = true;
    }

    Private void jump() {
        If (!started || gameOver) {
            Reset();
            Return;
        }
        If (onGround) {
            velY = JUMP_VELOCITY;
            onGround = false;
        }
    }

    Private void dash() {
        If (!started || gameOver) return;
        If (dashTimer == 0) {
            dashTimer = DASH_FRAMES;
        }
    }

    Private boolean isDashing() {
        Return dashTimer > 0;
    }

    Private Rectangle dinoHitbox() {
        Return new Rectangle(DINO_X + 5, (int) dinoY + 4, DINO_W – 10, DINO_H – 8);
    }

    /** Spawns an obstacle and returns the extra distance the next gap must include. */
    Private int spawnObstacle() {
        Boolean spikeStrip = progress > 150 && rng.nextInt(3) == 0;
        If (spikeStrip) {
            Int len = (int) (speed * SPIKE_LENGTH_FRAMES);
            Len -= len % SPIKE_W; // whole number of spikes
            Obstacles.add(new Obstacle(WIDTH + 20, GROUND_Y – SPIKE_H, len, SPIKE_H, true));
            Return len;
        } else {
            Int type = rng.nextInt(3);
            Int w = 20 + type * 14;          // small, medium, wide cluster
            Int h = 36 + rng.nextInt(20);
            Obstacles.add(new Obstacle(WIDTH + 20, GROUND_Y – h, w, h, false));
            Return 0;
        }
    }

    /** True when nothing is near the right edge, so a heart won’t spawn inside an obstacle. */
    Private boolean spawnAreaClear() {
        For (Obstacle o : obstacles) {
            If (o.x + o.w > WIDTH – 80) return false;
        }
        For (Heart h : hearts) {
            If (h.x > WIDTH – 120) return false;
        }
        For (Meat m : meats) {
            If (m.x > WIDTH – 120) return false;
        }
        Return nextGap – distanceSinceSpawn > 220;
    }

    Private void spawnHeart() {
        Boolean air = rng.nextBoolean();
        Int y = air
            ? GROUND_Y – 70 – rng.nextInt(50) – HEART_SIZE   // reachable with a jump
            : GROUND_Y – HEART_SIZE – 6;                     // reachable by running into it
        Hearts.add(new Heart(WIDTH + 20, y, air));
    }

    Private void spawnMeat() {
        Boolean air = rng.nextBoolean();
        Int y = air
            ? GROUND_Y – 70 – rng.nextInt(50) – MEAT_SIZE   // reachable with a jump
            : GROUND_Y – MEAT_SIZE – 6;                     // reachable by running into it
        Meats.add(new Meat(WIDTH + 20, y, air));
    }

    Private void update() {
        Frame++;

        // How fast the world scrolls this frame (dash = speed burst)
        Double worldSpeed = isDashing() ? speed * DASH_MULT : speed;

        // Cloud drift always runs
        For (double[] c : clouds) {
            C[0] -= 0.5;
            If (c[0] < -60) {
                C[0] = WIDTH + rng.nextInt(200);
                C[1] = 30 + rng.nextInt(80);
            }
        }

        If (!started || gameOver) return;

        // Score & difficulty (based on base speed so dash can’t be farmed for points)
        Score += speed * 0.1;
        Progress += speed * 0.1;
        Speed = Math.min(15, speed + 0.002);
        groundOffset = (groundOffset + worldSpeed) % 40;

        if (dashTimer > 0) dashTimer--;
        if (invuln > 0) invuln--;
        if (penaltyTimer > 0) penaltyTimer--;
        if (bonusTimer > 0) bonusTimer--;

        // Dino physics
        If (!onGround) {
            velY += GRAVITY;
            dinoY += velY;
            if (dinoY >= GROUND_Y – DINO_H) {
                dinoY = GROUND_Y – DINO_H;
                velY = 0;
                onGround = true;
            }
        }

        // Obstacle spawning
        distanceSinceSpawn += worldSpeed;
        if (distanceSinceSpawn >= nextGap) {
            int extra = spawnObstacle();
            distanceSinceSpawn = 0;
            nextGap = extra + 350 + rng.nextInt(300) + speed * 12;
        }

        // Heart pickups only appear while the player has no heart
        If (!hasHeart && hearts.isEmpty()) {
            If (heartCountdown > 0) {
                heartCountdown--;
            } else if (spawnAreaClear()) {
                spawnHeart();
            }
        }

        // Meat pickups appear at random once the score passes the threshold
        If (score >= MEAT_SCORE_REQUIRED && meats.isEmpty()) {
            If (meatCountdown > 0) {
                meatCountdown--;
            } else if (spawnAreaClear()) {
                spawnMeat();
            }
        }

        // Move obstacles & check collisions
        Rectangle dino = dinoHitbox();
        Boolean hit = false;
        Iterator<Obstacle> it = obstacles.iterator();
        While (it.hasNext()) {
            Obstacle o = it.next();
            o.x -= worldSpeed;
            if (o.x + o.w < 0) {
                it.remove();
                continue;
            }
            If (dino.intersects(o.hitbox())) {
                Hit = true;
            }
        }

        If (hit && invuln == 0) {
            If (hasHeart) {
                // Heart saves the player: lose 300 points, keep the speed
                hasHeart = false;
                invuln = INVULN_FRAMES;
                score = Math.max(0, score – HEART_PENALTY);
                penaltyTimer = 60;
                heartCountdown = 180 + rng.nextInt(240);
            } else {
                gameOver = true;
                highScore = Math.max(highScore, (int) score);
            }
        }

        // Move & collect heart pickups
        Iterator<Heart> hi = hearts.iterator();
        While (hi.hasNext()) {
            Heart h = hi.next();
            h.x -= worldSpeed;
            if (dino.intersects(h.box())) {
                hasHeart = true;
                hi.remove();
            } else if (h.x + HEART_SIZE < 0) {
                Hi.remove();                          // missed it
                heartCountdown = 120 + rng.nextInt(240);
            }
        }

        // Move & collect meat pickups
        Iterator<Meat> mi = meats.iterator();
        While (mi.hasNext()) {
            Meat m = mi.next();
            m.x -= worldSpeed;
            if (dino.intersects(m.box())) {
                score += MEAT_POINTS;
                bonusTimer = 60;
                meatCountdown = 240 + rng.nextInt(300);
                mi.remove();
            } else if (m.x + MEAT_SIZE < 0) {
                mi.remove();                          // missed it
                meatCountdown = 180 + rng.nextInt(300);
            }
        }
    }

    @Override
    Public void actionPerformed(ActionEvent e) {
        Update();
        Repaint();
    }

    // ------------------------------------------------------------------
    // Rendering
    // ------------------------------------------------------------------

    @Override
    Protected void paintComponent(Graphics g0) {
        Super.paintComponent(g0);
        Graphics2D g = (Graphics2D) g0;
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        drawClouds(g);
        drawGround(g);

        // Dash afterimages trail behind the dino
        If (isDashing() && !gameOver) {
            For (int I = 4; I >= 1; i--) {
                Int alpha = 120 – I * 22;
                drawDino(g, DINO_X – I * 14, (int) dinoY, new Color(83, 83, 83, alpha), false);
            }
        }
        // Dino flickers while briefly protected after losing the heart
        Boolean visible = invuln == 0 || (invuln / 5) % 2 == 0;
        If (visible) {
            drawDino(g, DINO_X, (int) dinoY, FG, true);
        }

        For (Obstacle o : obstacles) {
            If (o.spikes) drawSpikes(g, o); else drawCactus(g, o);
        }
        For (Heart h : hearts) {
            Int bob = h.air ? (int) (Math.sin(frame * 0.12) * 3) : 0;
            drawHeart(g, (int) h.x, h.y + bob, HEART_SIZE, true);
        }
        For (Meat m : meats) {
            Int bob = m.air ? (int) (Math.sin(frame * 0.12) * 3) : 0;
            drawMeat(g, (int) m.x, m.y + bob);
        }
        drawHud(g);

        Toolkit.getDefaultToolkit().sync();
    }

    Private void drawHeart(Graphics2D g, int x, int y, int size, boolean filled) {
        Double w = size, h = size * 0.9;
        Path2D.Double p = new Path2D.Double();
        p.moveTo(x + w / 2, y + h);
        p.curveTo(x – w * 0.25, y + h * 0.45, x + w * 0.05, y – h * 0.2, x + w / 2, y + h * 0.3);
        p.curveTo(x + w * 0.95, y – h * 0.2, x + w * 1.25, y + h * 0.45, x + w / 2, y + h);
        p.closePath();
        if (filled) {
            g.setColor(HEART_RED);
            g.fill(p);
        } else {
            g.setColor(new Color(83, 83, 83, 130));
            g.setStroke(new BasicStroke(2f));
            g.draw(p);
            g.setStroke(new BasicStroke(1f));
        }
    }

    Private void drawMeat(Graphics2D g, int x, int y) {
        // bone
        g.setStroke(new BasicStroke(5f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
        g.setColor(FG);
        g.drawLine(x + 10, y + 14, x + 4, y + 20);
        g.setStroke(new BasicStroke(3f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
        g.setColor(new Color(240, 230, 210));
        g.drawLine(x + 10, y + 14, x + 4, y + 20);
        g.setStroke(new BasicStroke(1f));
        g.setColor(FG);
        g.fillOval(x, y + 18, 6, 6);
        g.fillOval(x + 4, y + 20, 5, 5);
        g.setColor(new Color(240, 230, 210));
        g.fillOval(x + 1, y + 19, 4, 4);
        g.fillOval(x + 5, y + 21, 3, 3);
        // meat
        g.setColor(new Color(176, 92, 52));
        g.fillOval(x + 6, y, 18, 16);
        g.setColor(new Color(120, 58, 28));
        g.drawOval(x + 6, y, 18, 16);
        g.setColor(new Color(210, 130, 85));
        g.fillOval(x + 11, y + 3, 6, 4);
    }

    Private void drawClouds(Graphics2D g) {
        g.setColor(new Color(220, 220, 220));
        for (double[] c : clouds) {
            int x = (int) c[0], y = (int) c[1];
            g.fillRoundRect(x, y, 50, 14, 14, 14);
            g.fillRoundRect(x + 10, y – 8, 28, 14, 14, 14);
        }
    }

    Private void drawGround(Graphics2D g) {
        g.setColor(FG);
        g.drawLine(0, GROUND_Y, WIDTH, GROUND_Y);
        // little bumps scrolling past
        For (int I = -1; I < WIDTH / 40 + 2; i++) {
            Int x = (int) (I * 40 – groundOffset);
            g.drawLine(x + 8, GROUND_Y + 6, x + 14, GROUND_Y + 6);
            g.drawLine(x + 26, GROUND_Y + 12, x + 30, GROUND_Y + 12);
        }
    }

    Private void drawDino(Graphics2D g, int x, int y, Color body, boolean real) {
        Boolean runFrame = (frame / 6) % 2 == 0;
        Boolean dashing = isDashing();

        g.setColor(body);
        g.fillRect(x + 8, y + 14, 28, 22);     // body
        g.fillRect(x + 16, y, 28, 16);         // head
        g.fillRect(x, y + 18, 10, 8);          // tail
        g.fillRect(x + 34, y + 24, 8, 3);      // arm

        // legs
        If (!onGround || !started || gameOver || dashing) {
            g.fillRect(x + 12, y + 36, 7, 8);
            g.fillRect(x + 25, y + 36, 7, 8);
        } else if (runFrame) {
            g.fillRect(x + 12, y + 36, 7, 8);
            g.fillRect(x + 25, y + 36, 7, 4);
        } else {
            g.fillRect(x + 12, y + 36, 7, 4);
            g.fillRect(x + 25, y + 36, 7, 8);
        }

        If (!real) return;

        // eye
        g.setColor(BG);
        if (gameOver) {
            g.drawLine(x + 34, y + 3, x + 38, y + 7);
            g.drawLine(x + 38, y + 3, x + 34, y + 7);
        } else {
            g.fillRect(x + 34, y + 3, 4, 4);
        }

        // speed lines behind the dino while dashing
        If (dashing && !gameOver) {
            g.setColor(new Color(83, 83, 83, 120));
            for (int I = 0; I < 3; i++) {
                int ly = y + 10 + I * 12;
                g.drawLine(x – 70, ly, x – 100 – I * 8, ly);
            }
        }
    }

    Private void drawCactus(Graphics2D g, Obstacle o) {
        g.setColor(FG);
        int x = (int) o.x;
        int stemW = 10;
        int count = Math.max(1, o.w / 16);
        for (int I = 0; I < count; i++) {
            int cx = x + I * 14;
            int hh = o.h – (I % 2) * 8;
            int top = GROUND_Y – hh;
            g.fillRoundRect(cx, top, stemW, hh, 6, 6);           
            g.fillRect(cx – 5, top + hh / 3, 6, 4);              
            g.fillRect(cx – 5, top + hh / 3 – 8, 4, 12);
            g.fillRect(cx + stemW – 1, top + hh / 2, 6, 4);      
            g.fillRect(cx + stemW + 1, top + hh / 2 – 8, 4, 12);
        }
    }

    Private void drawSpikes(Graphics2D g, Obstacle o) {
        g.setColor(FG);
        int x = (int) o.x;
        int count = o.w / SPIKE_W;
        for (int I = 0; I < count; i++) {
            int sx = x + I * SPIKE_W;
            g.fillPolygon(
                new int[]{sx, sx + SPIKE_W, sx + SPIKE_W / 2},
                new int[]{GROUND_Y, GROUND_Y, GROUND_Y – SPIKE_H},
                3);
        }
    }

    Private void drawHud(Graphics2D g) {
        // Heart indicator (top-left): filled = protected, outline = no heart
        drawHeart(g, 20, 14, 24, hasHeart);
        g.setColor(FG);
        g.setFont(new Font(Font.MONOSPACED, Font.BOLD, 18));
        String s = String.format(“HI %05d  %05d”, highScore, (int) score);
        g.drawString(s, WIDTH – 200, 30);
        if (penaltyTimer > 0) {
            g.setColor(HEART_RED);
            g.drawString(“-“ + HEART_PENALTY, WIDTH – 100, 52 – (60 – penaltyTimer) / 6);
        }

        If (bonusTimer > 0) {
            g.setColor(new Color(176, 92, 52));
            g.drawString(“+” + MEAT_POINTS, WIDTH – 200, 52 – (60 – bonusTimer) / 6);
        }
        g.setColor(FG);
        g.setFont(new Font(Font.MONOSPACED, Font.BOLD, 22));

        if (!started) {
            center(g, “Press SPACE to start”, 115);
            g.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 14));

            center(g, “SPACE/UP = jump     DOWN/SHIFT = dash”, 143);
            center(g, “Spike strips are too long to jump – jump + dash!”, 163);
            center(g, “Your heart saves you once. Grab a new one when it appears.”, 183);
            center(g, “After 500 points, meat shows up: +100 points.”, 203);
        } else if (gameOver) {
            Center(g, “G A M E   O V E R”, 110);
            g.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 16));
            center(g, “Press SPACE to restart”, 140);
        }
    }
    Private void center(Graphics2D g, String text, int y) {
        Int w = g.getFontMetrics().stringWidth(text);
        g.drawString(text, (WIDTH – w) / 2, y);
    }
    // ------------------------------------------------------------------
    // Input
    // ------------------------------------------------------------------
    @Override
    Public void keyPressed(KeyEvent e) {
        Switch (e.getKeyCode()) {
            Case KeyEvent.VK_SPACE:
            Case KeyEvent.VK_UP:
                Jump();
                Break;
            Case KeyEvent.VK_DOWN:
            Case KeyEvent.VK_SHIFT:
                If (!dashKeyHeld) {   // ignore key auto-repeat
                    dashKeyHeld = true;
                    dash();
                }
                Break;
            Default:
                Break;
        }
    }

    @Override
    Public void keyReleased(KeyEvent e) {
        If (e.getKeyCode() == KeyEvent.VK_DOWN || e.getKeyCode() == KeyEvent.VK_SHIFT) {
            dashKeyHeld = false;
        }
    }

    @Override
    Public void keyTyped(KeyEvent e) { }

    // ------------------------------------------------------------------
    Public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {

            JFrame frame = new JFrame(“Dino Game”);
            Frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            Frame.setResizable(false);
            Frame.add(new DinoGame());
            Frame.pack();
            Frame.setLocationRelativeTo(null);
            Frame.setVisible(true);
        });
    }
}


